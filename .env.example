# Contact form delivery. Without these the form shows a mailto fallback
# rather than silently dropping enquiries.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="The Peacock <hello@thepeacock.com.au>"
CONTACT_TO_EMAIL=hello@thepeacock.com.au

# Server-only Square catalog access. Never use NEXT_PUBLIC_ for secrets.
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=production
# Required if the account has multiple active AUD locations.
SQUARE_LOCATION_ID=
# Optional comma-separated category IDs to limit published items.
SQUARE_MENU_CATEGORY_IDS=

# --- Booking system -------------------------------------------------------
# Signs the owner's session cookie. Without it sessions are signed with a
# random per-instance secret, so the owner is signed out by a deploy or a cold
# start. Generate one with: openssl rand -base64 32
PEACOCK_SESSION_SECRET=

# The owner's credentials. Both have working defaults (owner / password12345)
# so the handover build signs in out of the box. Replace them before the venue
# takes real bookings: the run sheet holds guests' names, phones and emails.
# Hash a new password with: printf 'the password' | npm run hash-password
PEACOCK_OWNER_USERNAME=owner
PEACOCK_OWNER_PASSWORD_HASH=

# Where the diary lives. With neither of these set, bookings go to a JSON file
# under .data/ — fine locally, useless on Vercel, where the filesystem is
# per-instance and thrown away. Point these at Vercel KV / Upstash before
# deploying, or bookings will silently disappear.
KV_REST_API_URL=
KV_REST_API_TOKEN=
