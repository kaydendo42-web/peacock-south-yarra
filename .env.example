# Contact form delivery. Without these the form shows a mailto fallback
# rather than silently dropping enquiries.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="The Peacock <hello@thepeacock.com.au>"
CONTACT_TO_EMAIL=hello@thepeacock.com.au
# Booking emails reuse RESEND_API_KEY. Both optional: the from-address falls
# back to CONTACT_FROM_EMAIL and the venue alert to CONTACT_TO_EMAIL. The
# from-address's domain must be verified in Resend, or Resend will only
# deliver to the account owner's own address.
BOOKING_FROM_EMAIL="The Peacock <bookings@thepeacock.com.au>"
BOOKING_NOTIFY_EMAIL=

# Server-only Square catalog access. Never use NEXT_PUBLIC_ for secrets.
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=production
# Required if the account has multiple active AUD locations.
SQUARE_LOCATION_ID=
# Optional comma-separated category IDs to limit published items.
SQUARE_MENU_CATEGORY_IDS=

# --- Booking system -------------------------------------------------------
# Signs the owner's session cookie. Without it sessions are signed with a
# random per-instance secret, so the owner is signed out by a deploy or a cold
# start. Generate one with: openssl rand -base64 32
PEACOCK_SESSION_SECRET=

# The owner's credentials. Both have working defaults (owner / password12345)
# so the handover build signs in out of the box. Replace them before the venue
# takes real bookings: the run sheet holds guests' names, phones and emails.
# Hash a new password with: printf 'the password' | npm run hash-password
PEACOCK_OWNER_USERNAME=owner
PEACOCK_OWNER_PASSWORD_HASH=

# Where the diary lives. With neither of these set, bookings go to a JSON file
# under .data/ — fine locally, useless on Vercel, where the filesystem is
# per-instance and thrown away. Connect Upstash for Redis from the Vercel
# Marketplace and it sets both. Check it with: npm run store:check
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Changing a booking from the confirmation email -------------------------
# Signs each guest's "change or cancel" link. Optional: without it the key is
# derived from SUPABASE_SERVICE_ROLE_KEY. Changing it breaks links already sent.
BOOKING_MANAGE_SECRET=

# --- $5 dinners (/dinners) ---------------------------------------------------
# Payment uses SQUARE_ACCESS_TOKEN and SQUARE_LOCATION_ID above; the token needs
# ORDERS_READ, ORDERS_WRITE and PAYMENTS_WRITE. Without them, production shows
# the menu with ordering off.
# From the webhook subscription in the Square Developer Dashboard (event
# payment.updated, URL https://www.thepeacock.com.au/api/dinners/webhook).
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Only if the subscription URL differs from <site>/api/dinners/webhook.
SQUARE_WEBHOOK_URL=
# Vercel sends this to the 9pm pickup-list cron. openssl rand -base64 32
CRON_SECRET=
# Where the 9pm pickup list goes. Falls back to BOOKING_NOTIFY_EMAIL.
DINNERS_NOTIFY_EMAIL=
